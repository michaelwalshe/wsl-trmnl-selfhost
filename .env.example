# Copy this file to .env and fill in your own values.
# .env is gitignored -- these are personal to your install, not committed.

# Your location, for the Open-Meteo weather lookup. Resolve a place name to
# coordinates with Open-Meteo's own free geocoding API, e.g.:
#   curl "https://geocoding-api.open-meteo.com/v1/search?name=Oxford&count=1"
# Example below is central London -- replace with your own location.
WEATHER_LATITUDE=51.5074
WEATHER_LONGITUDE=-0.1278

# IANA timezone name, used for both the calendar's day boundaries and the
# weather sunrise/sunset formatting.
LOCAL_TIMEZONE=Europe/London

# Optional: comma-separated patterns (case-insensitive; plain text or regex)
# for calendar events to hide from the dashboard entirely, matched against
# the event summary. Leave unset to show everything.
# EXCLUDED_EVENT_SUMMARY_PATTERNS=Complete Timesheet,Some Other Recurring Thing

# Optional: comma-separated calendar names (case-insensitive exact match,
# not a pattern) to skip entirely -- e.g. a calendar you're subscribed to
# but don't want on the dashboard at all. Leave unset to show every
# calendar the authorised account can see.
# EXCLUDED_CALENDAR_SUMMARIES=Some Subscribed Calendar,Another One
